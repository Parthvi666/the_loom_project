generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Artisan {
  id                String    @id @default(cuid())
  fullName           String
  email             String    @unique
  passwordHash       String
  preferredLanguage String    @default("en")
  region            String?
  craft             String?
  bio               String?
  profileImage      String?
  products          Product[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  category           String
  craft              String
  material           String?
  region             String?
  productionTime     String?
  materialCost       Float?
  labourCost         Float?
  packagingCost      Float?
  otherCosts         Float?
  recommendedPrice   Float?
  finalPrice         Float?
  descriptionEnglish String?
  descriptionHindi   String?
  tags               String   @default("[]")
  images             String   @default("[]")
  interviewAnswers   String   @default("[]")
  status             String   @default("draft")
  artisanId          String
  artisan            Artisan  @relation(fields: [artisanId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}